// use prisma-next

model Product {
  id           Int              @id @default(autoincrement())
  slug         String           @unique
  name         String
  displayName  String
  description  String?
  category     String
  price        Decimal
  material     String?
  active       Boolean          @default(true)
  trackStock   Boolean          @default(true)

  images       Json
  viewerImages Json
  details      Json

  variants     ProductVariant[]

  createdAt    TimestamptzString @default(now())
  updatedAt    temporal.updatedAtString()
}

model ProductVariant {
  id          Int                 @id @default(autoincrement())
  productId   Int
  sku         String              @unique
  name        String
  stock       Int                 @default(0)
  active      Boolean             @default(true)

  product     Product             @relation(fields: [productId], references: [id])
  movements   InventoryMovement[]

  createdAt   TimestamptzString   @default(now())
  updatedAt   temporal.updatedAtString()
}

model InventoryMovement {
  id          Int               @id @default(autoincrement())
  variantId   Int
  quantity    Int
  type        String
  reason      String?
  reference   String?

  variant     ProductVariant    @relation(fields: [variantId], references: [id])

  createdAt   TimestamptzString @default(now())
}

model Order {
  id            Int               @id @default(autoincrement())
  code          String            @unique
  status        String            @default("pending")
  subtotal      Decimal
  total         Decimal
  customerName  String?
  customerEmail String?
  customerPhone String?

  items         OrderItem[]

  createdAt     TimestamptzString @default(now())
  updatedAt     temporal.updatedAtString()
}

model OrderItem {
  id          Int               @id @default(autoincrement())
  orderId     Int
  productId   Int
  variantId   Int

  productName String
  variantName String
  sku         String

  quantity    Int
  unitPrice   Decimal
  totalPrice  Decimal

  order       Order             @relation(fields: [orderId], references: [id])

  createdAt   TimestamptzString @default(now())
}